{
  "name": "kids-box-learning",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "art:transparent": "node scripts/prepare-transparent-art.mjs",
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "vitest run",
    "android:sync": "npm run build && cap sync android",
    "android:build": "node scripts/build-android.mjs",
    "android:apk": "npm run android:sync && npm run android:build",
    "android:release": "npm run android:sync && node scripts/build-android.mjs --release",
    "version:release": "node scripts/set-release-version.mjs"
  },
  "dependencies": {
    "@capacitor/android": "^8.6.0",
    "@capacitor/core": "^8.6.0",
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@fontsource-variable/nunito": "^5.3.0",
    "gsap": "^3.13.0",
    "lucide-react": "^0.468.0",
    "motion": "^12.43.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "sharp": "^0.35.5",
    "typescript": "~5.9.3",
    "vite": "^7.2.0",
    "vitest": "^3.2.0"
  }
}
